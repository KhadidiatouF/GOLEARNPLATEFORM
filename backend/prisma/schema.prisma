generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id             Int             @id @default(autoincrement())
  nom            String
  prenom         String
  email          String          @unique
  login          String          @unique
  mdp            String
  dateCreation   DateTime        @default(now())
  role           Role
  solde          Float?
  administrateur Administrateur?
  apprenant      Apprenant?
  professeur     Professeur?
}

model Professeur {
  id            Int         @id @default(autoincrement())
  specialite    String?     // Ajouté pour le seed
  bio           String?     // Ajouté pour le seed
  utilisateurId Int         @unique
  formations    Formation[]
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
}

model Apprenant {
  id             Int                  @id @default(autoincrement())
  niveau         String?              // Ajouté pour le seed
  utilisateurId  Int                  @unique
  utilisateur    Utilisateur          @relation(fields: [utilisateurId], references: [id])
  formations     ApprenantFormation[]
  certifications Certification[]
  paiements      Paiement[]
}

model Administrateur {
  id            Int         @id @default(autoincrement())
  utilisateurId Int         @unique
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
}

model Formation {
  id             Int                  @id @default(autoincrement())
  titre          String
  description    String
  prix           Float
  categorie      String
  dateCreation   DateTime             @default(now())
  niveau         String
  image          String?
  typeCours      TypeCours
  professeurId   Int
  apprenants     ApprenantFormation[]
  certifications Certification[]
  professeur     Professeur           @relation(fields: [professeurId], references: [id])
  quiz           Quiz[]
  sessions       Session[]

  @@index([professeurId], map: "Formation_professeurId_fkey")
}

model Session {
  id          Int         @id @default(autoincrement())
  titre       String
  contenu     String
  duree       String
  typeContenu TypeContenu
  formationId Int
  quiz        Quiz[]
  formation   Formation   @relation(fields: [formationId], references: [id])

  @@index([formationId], map: "Session_formationId_fkey")
}

model Paiement {
  id            Int           @id @default(autoincrement())
  montant       Float
  moyenPaiement MoyenPaiement
  datePaiement  DateTime      @default(now())
  apprenantId   Int
  apprenant     Apprenant     @relation(fields: [apprenantId], references: [id])

  @@index([apprenantId], map: "Paiement_apprenantId_fkey")
}

model Certification {
  id            Int       @id @default(autoincrement())
  dateObtention DateTime  @default(now())
  apprenantId   Int
  formationId   Int
  apprenant     Apprenant @relation(fields: [apprenantId], references: [id])
  formation     Formation @relation(fields: [formationId], references: [id])

  @@index([apprenantId], map: "Certification_apprenantId_fkey")
  @@index([formationId], map: "Certification_formationId_fkey")
}

model ApprenantFormation {
  id          Int       @id @default(autoincrement())
  apprenantId Int
  formationId Int
  apprenant   Apprenant @relation(fields: [apprenantId], references: [id])
  formation   Formation @relation(fields: [formationId], references: [id])

  @@unique([apprenantId, formationId])
}

model Quiz {
  id          Int        @id @default(autoincrement())
  score       Float?
  formationId Int
  sessionId   Int
  questions   Question[]
  formation   Formation  @relation(fields: [formationId], references: [id])
  session     Session    @relation(fields: [sessionId], references: [id])
}

model Question {
  id       Int       @id @default(autoincrement())
  contenu  String
  quizId   Int
  quiz     Quiz      @relation(fields: [quizId], references: [id])
  reponses Reponse[]
}

model Reponse {
  id          Int      @id @default(autoincrement())
  contenu     String
  estCorrecte Boolean
  questionId  Int
  question    Question @relation(fields: [questionId], references: [id])
}

enum Role {
  ADMIN
  PROF
  APPRENANT
}

enum TypeContenu {
  VIDEO
  PDF
  TEXTE
}

enum MoyenPaiement {
  WAVE
  OM
  CARTE_BANCAIRE
}

enum TypeCours {
  PAYANT
  GRATUIT
}