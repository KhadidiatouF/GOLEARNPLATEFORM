generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id             Int             @id @default(autoincrement())
  nom            String
  prenom         String
  email          String          @unique
  login          String          @unique
  mdp            String
  dateCreation   DateTime        @default(now())
  role           Role
  solde          Float?
  administrateur Administrateur?
  apprenant      Apprenant?
  professeur     Professeur?
}

model Professeur {
  id            Int              @id @default(autoincrement())
  specialite    String? // Ajouté pour le seed
  bio           String? // Ajouté pour le seed
  utilisateurId Int              @unique
  formations    Formation[]
  utilisateur   Utilisateur      @relation(fields: [utilisateurId], references: [id])
  statut        StatutProfesseur @default(EN_ATTENTE)
}

model Apprenant {
  id             Int                  @id @default(autoincrement())
  niveau         String? // Ajouté pour le seed
  utilisateurId  Int                  @unique
  utilisateur    Utilisateur          @relation(fields: [utilisateurId], references: [id])
  formations     ApprenantFormation[]
  certifications Certification[]
}

model Administrateur {
  id            Int         @id @default(autoincrement())
  utilisateurId Int         @unique
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
}

model Formation {
  id             Int                  @id @default(autoincrement())
  titre          String
  description    String
  prix           Float
  categorie      String
  dateCreation   DateTime             @default(now())
  niveau         String
  image          String?
  typeCours      TypeCours
  professeurId   Int
  apprenants     ApprenantFormation[]
  certifications Certification[]
  professeur     Professeur           @relation(fields: [professeurId], references: [id])
  quiz           Quiz[]
  sessions       Session[]
  statut         StatutFormation      @default(EN_ATTENTE)

  @@index([professeurId], map: "Formation_professeurId_fkey")
}

model Session {
  id          Int        @id @default(autoincrement())
  titre       String
  contenu     String?
  duree       String
  chapitres   Chapitre[]
  quiz        Quiz?
  formationId Int
  formation   Formation  @relation(fields: [formationId], references: [id])

  @@index([formationId], map: "Session_formationId_fkey")
}

model Chapitre {
  id           Int                 @id @default(autoincrement())
  titre        String
  contenu      String              @db.Text
  duree        String
  typeContenu  TypeContenu
  ordre        Int                 @default(0)
  videoUrl     String? // URL video (YouTube, Vimeo, etc.)
  pdfUrl       String? // URL PDF
  sessionId    Int
  session      Session             @relation(fields: [sessionId], references: [id])
  progressions ApprenantChapitre[]

  @@index([sessionId], map: "Chapitre_sessionId_fkey")
}

model Paiement {
  id                   Int                @id @default(autoincrement())
  montant              Float
  moyenPaiement        MoyenPaiement
  datePaiement         DateTime           @default(now())
  statut               StatutPaiement     @default(EN_ATTENTE)
  transactionId        String?            @unique
  reference            String?            @unique
  callbackData         Json?
  apprenantFormationId Int
  apprenantFormation   ApprenantFormation @relation(fields: [apprenantFormationId], references: [id])

  @@index([apprenantFormationId], map: "Paiement_apprenantFormationId_fkey")
}

model Certification {
  id            Int       @id @default(autoincrement())
  dateObtention DateTime  @default(now())
  apprenantId   Int
  formationId   Int
  apprenant     Apprenant @relation(fields: [apprenantId], references: [id])
  formation     Formation @relation(fields: [formationId], references: [id])

  @@index([apprenantId], map: "Certification_apprenantId_fkey")
  @@index([formationId], map: "Certification_formationId_fkey")
}

model ApprenantFormation {
  id          Int          @id @default(autoincrement())
  apprenantId Int
  formationId Int
  progression Progression?
  apprenant   Apprenant    @relation(fields: [apprenantId], references: [id])
  formation   Formation    @relation(fields: [formationId], references: [id])
  paiements   Paiement[]

  @@unique([apprenantId, formationId])
}

model Progression {
  id                   Int                 @id @default(autoincrement())
  apprenantFormationId Int                 @unique
  chapitresCompletes   ApprenantChapitre[]
  dateDerniereActivite DateTime            @default(now())
  apprenantFormation   ApprenantFormation  @relation(fields: [apprenantFormationId], references: [id])
}

model ApprenantChapitre {
  id             Int         @id @default(autoincrement())
  estComplete    Boolean     @default(false)
  dateCompletion DateTime?
  progressionId  Int
  chapitreId     Int
  progression    Progression @relation(fields: [progressionId], references: [id])
  chapitre       Chapitre    @relation(fields: [chapitreId], references: [id])

  @@unique([progressionId, chapitreId])
}

model Quiz {
  id          Int        @id @default(autoincrement())
  score       Float?
  formationId Int
  sessionId   Int?        @unique
  type        TypeQuiz   @default(SESSION)
  questions   Question[]
  formation   Formation  @relation(fields: [formationId], references: [id])
  session     Session?    @relation(fields: [sessionId], references: [id])
}

model Question {
  id       Int       @id @default(autoincrement())
  contenu  String
  quizId   Int
  quiz     Quiz      @relation(fields: [quizId], references: [id])
  reponses Reponse[]
}

model Reponse {
  id          Int      @id @default(autoincrement())
  contenu     String
  estCorrecte Boolean
  questionId  Int
  question    Question @relation(fields: [questionId], references: [id])
}

enum Role {
  ADMIN
  PROF
  APPRENANT
}

enum StatutProfesseur {
  EN_ATTENTE
  VALIDE
  REJETE
}

enum StatutFormation {
  EN_ATTENTE
  VALIDEE
  REJETEE
}

enum TypeContenu {
  VIDEO
  PDF
  TEXTE
}

enum MoyenPaiement {
  WAVE
  OM
  CARTE_BANCAIRE
}

enum TypeCours {
  PAYANT
  GRATUIT
}

enum TypeQuiz {
  SESSION
  FINAL
}

enum StatutPaiement {
  EN_ATTENTE
  VALIDE
  ECHOUE
  ANNULE
}
