{
  "openapi": "3.0.0",
  "info": {
    "title": "API Formation",
    "version": "1.0.0",
    "description": "API pour la plateforme de formation en ligne"
  },
  "servers": [
    {
      "url": "http://localhost:4004",
      "description": "Serveur local"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Connexion utilisateur",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "login": { "type": "string" },
                  "mdp": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Connexion réussie" },
          "401": { "description": "Identifiants invalides" }
        }
      }
    },
    "/formations": {
      "get": {
        "summary": "Liste des formations",
        "tags": ["Formations"],
        "responses": {
          "200": { "description": "Liste des formations" }
        }
      }
    }
  }
}
