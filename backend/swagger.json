{
  "openapi": "3.0.0",
  "info": {
    "title": "API Formation",
    "version": "1.0.0",
    "description": "API pour la plateforme de formation en ligne - Documentation Swagger avec tous les endpoints"
  },
  "servers": [
    {
      "url": "http://localhost:4004",
      "description": "Serveur local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "statusCode": { "type": "integer" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["login", "mdp"],
        "properties": {
          "login": { "type": "string", "description": "Email ou nom d'utilisateur" },
          "mdp": { "type": "string", "description": "Mot de passe" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "user": { "type": "object" }
        }
      },
      "Utilisateur": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "email": { "type": "string" },
          "nom": { "type": "string" },
          "prenom": { "type": "string" },
          "role": { "type": "string" },
          "telephone": { "type": "string" },
          "photo": { "type": "string" }
        }
      },
      "Professeur": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "utilisateurId": { "type": "integer" },
          "specialite": { "type": "string" },
          "biographie": { "type": "string" }
        }
      },
      "Apprenant": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "utilisateurId": { "type": "integer" },
          "niveau": { "type": "string" }
        }
      },
      "Administrateur": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "utilisateurId": { "type": "integer" },
          "niveauAcces": { "type": "string" }
        }
      },
      "Formation": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "titre": { "type": "string" },
          "description": { "type": "string" },
          "duree": { "type": "integer" },
          "niveau": { "type": "string" },
          "photo": { "type": "string" },
          "professeurId": { "type": "integer" },
          "categorie": { "type": "string" },
          "prix": { "type": "number" }
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "formationId": { "type": "integer" },
          "dateDebut": { "type": "string", "format": "date-time" },
          "dateFin": { "type": "string", "format": "date-time" },
          "maxParticipants": { "type": "integer" },
          "statut": { "type": "string" }
        }
      },
      "Paiement": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "apprenantId": { "type": "integer" },
          "formationId": { "type": "integer" },
          "montant": { "type": "number" },
          "datePaiement": { "type": "string", "format": "date-time" },
          "statut": { "type": "string" },
          "methode": { "type": "string" }
        }
      },
      "Certification": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "apprenantId": { "type": "integer" },
          "formationId": { "type": "integer" },
          "dateObtention": { "type": "string", "format": "date-time" },
          "codeVerification": { "type": "string" }
        }
      },
      "Quiz": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "formationId": { "type": "integer" },
          "titre": { "type": "string" },
          "description": { "type": "string" },
          "duree": { "type": "integer" },
          "seuilReussite": { "type": "integer" }
        }
      },
      "Question": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "quizId": { "type": "integer" },
          "texte": { "type": "string" },
          "type": { "type": "string" },
          "points": { "type": "integer" }
        }
      },
      "Reponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "questionId": { "type": "integer" },
          "texte": { "type": "string" },
          "estCorrecte": { "type": "boolean" }
        }
      },
      "Progression": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "apprenantFormationId": { "type": "integer" },
          "chapitreId": { "type": "integer" },
          "statut": { "type": "string" },
          "tempsPasse": { "type": "integer" }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Connexion utilisateur (Public - Pas d'authentification requise)",
        "tags": ["Auth - Public"],
        "description": "Endpoint public - Permet de se connecter sans token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Connexion réussie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": { "description": "Identifiants invalides" }
        }
      }
    },
    "/auth/refresh": {
      "get": {
        "summary": "Rafraîchir le token",
        "tags": ["Auth"],
        "responses": {
          "200": { "description": "Token rafraîchi" },
          "401": { "description": "Token invalide ou expiré" }
        }
      }
    },
